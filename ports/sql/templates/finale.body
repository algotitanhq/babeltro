
-- font: the lit dots, (character, row, column)
DROP TABLE IF EXISTS font;
CREATE TABLE font (ch TEXT, row INTEGER, col INTEGER, PRIMARY KEY (ch, row, col)) WITHOUT ROWID;
INSERT INTO font
  SELECT ch, r.n, c.n FROM font_src, nums r, nums c
  WHERE r.n < 7 AND c.n < 5 AND substr(rows, r.n * 6 + c.n + 1, 1) = '1';

-- The layout, integer arithmetic as in Go's Resize: the wordmark takes the
-- room the rest leaves, at most 45% of the width.
DROP TABLE IF EXISTS fin_lay;
CREATE TABLE fin_lay AS
  WITH
  a AS (
    SELECT w, h, 'SQL' AS lang, 'EVERY PIXEL IS SQL' AS sub, 'ONE THREAD - NO GPU - NO SHADER' AS tag,
           max(1, w / 300) AS subs, max(1, w / 440) AS stats, h / 48 AS gap, h / 40 AS top,
           CAST(F32(h * F32(0.90)) AS INTEGER) AS bottom
    FROM size
  ),
  b AS (
    SELECT *, stats + 1 AS tags, 7 * stats * 3 / 2 AS statgap FROM a
  ),
  c AS (
    SELECT *, 7 * subs + 3 * statgap + 7 * tags + 4 * gap AS fixed FROM b
  ),
  d AS (
    SELECT *, max(3, min((bottom - top - fixed) * 2 / 21, w * 9 / 20 / (length(lang) * 6 - 1))) AS scale FROM c
  ),
  e AS (
    SELECT *, 7 * scale AS texth, 7 * scale / 2 AS reflh, (w - (length(lang) * 6 - 1) * scale) / 2 AS logox,
           top + (bottom - top - (7 * scale + 7 * scale / 2 + fixed)) / 2 AS logoy
    FROM d
  ),
  f AS (
    SELECT *, logoy + texth AS floory, logoy + texth + reflh + gap AS suby FROM e
  ),
  g AS (
    SELECT *, suby + 7 * subs + gap AS statsy, (w - (length(sub) * 6 - 1) * subs) / 2 AS subx,
           (w - (length(tag) * 6 - 1) * tags) / 2 AS tagx,
           F32(w * 0.5) AS glowx, F32(logoy + F32(texth * F32(0.55))) AS glowy, F32(w * F32(0.34)) AS glowr
    FROM f
  )
  SELECT *, statsy + 3 * statgap + gap AS tagy,
         CAST(glowx AS INTEGER) - CAST(F32(glowr / F32(1.6)) AS INTEGER) AS bx0,
         CAST(glowx AS INTEGER) + CAST(F32(glowr / F32(1.6)) AS INTEGER) AS bx1,
         CAST(glowy AS INTEGER) - CAST(glowr AS INTEGER) AS by0,
         CAST(glowy AS INTEGER) + CAST(glowr AS INTEGER) AS by1
  FROM g;

-- The text that does not move, as (layer, string, x, y, scale, colour);
-- layers drawn later win. The subtitle's rules are 1-pixel lines.
DROP TABLE IF EXISTS fin_text;
CREATE TABLE fin_text AS
  SELECT 4 AS layer, sub AS s, subx AS x, suby AS y, subs AS scale, 'FFE0F0FF' AS hex FROM fin_lay
  UNION ALL
  SELECT 5, l.s, (w - (length(l.s) * 6 - 1) * stats) / 2, statsy + l.k * statgap, stats, 'E0B0C0FF'
  FROM fin_lay, (SELECT 0 AS k, '0 GPU SHADERS' AS s UNION ALL SELECT 1, '0 EXTERNAL MODULES'
                 UNION ALL SELECT 2, '0 ASSETS ON DISK') l
  UNION ALL
  SELECT 6, tag, tagx, tagy, tags, 'FFE0B0FF' FROM fin_lay;

-- Text as a join: each character of each string, the glyph's lit dots, and
-- the scale×scale block of every dot, clipped to the frame.
DROP VIEW IF EXISTS fin_text_px;
CREATE VIEW fin_text_px AS
  SELECT t.layer, (t.y + f.row * t.scale + sy.n) * w + t.x + k.n * 6 * t.scale + f.col * t.scale + sx.n AS id, t.hex
  FROM fin_text t, size
  JOIN nums k ON k.n < length(t.s)
  JOIN font f ON f.ch = substr(t.s, k.n + 1, 1)
  JOIN nums sy ON sy.n < t.scale
  JOIN nums sx ON sx.n < t.scale
  WHERE t.x + k.n * 6 * t.scale + f.col * t.scale + sx.n BETWEEN 0 AND w - 1
    AND t.y + f.row * t.scale + sy.n BETWEEN 0 AND h - 1;

-- Every pixel's fixed part: the background ramp (one colour per row, with a
-- vignette), the glow's column and row terms where the glow can reach, the
-- polished floor line, and the fixed text on top.
DROP TABLE IF EXISTS fin_px;
CREATE TABLE fin_px (id INTEGER PRIMARY KEY, r INTEGER, g INTEGER, b INTEGER, dx2 REAL, dy2 REAL,
                     fr REAL, fg REAL, fb REAL, hex TEXT);
INSERT INTO fin_px
  WITH
  rows AS MATERIALIZED (
    SELECT n AS y, F32(n * F32(1 / CAST(h AS REAL))) AS u, F32(F32(n - h * 0.5) / (h * 0.5)) AS ny
    FROM size, nums WHERE n < h
  ),
  vig AS MATERIALIZED (
    SELECT y, u, max(F32(0.45), F32(1 - F32(F32(F32(0.32) * ny) * ny))) AS vig FROM rows
  ),
  rc AS MATERIALIZED (
    SELECT y,
      F32(F32(F32(0.02) + F32(F32(F32(0.09) * u) * u)) * vig) AS r,
      F32(F32(F32(0.01) + F32(F32(0.02) * u)) * vig) AS g,
      F32(F32(F32(0.06) + F32(F32(0.14) * u)) * vig) AS b
    FROM vig
  ),
  rowc AS MATERIALIZED (
    SELECT y, iif(r <= 0, 0, iif(r >= 1, 255, CAST(r * 255 + 0.5 AS INTEGER))) AS r,
              iif(g <= 0, 0, iif(g >= 1, 255, CAST(g * 255 + 0.5 AS INTEGER))) AS g,
              iif(b <= 0, 0, iif(b >= 1, 255, CAST(b * 255 + 0.5 AS INTEGER))) AS b,
           iif(y >= max(by0, 0) AND y < min(by1, h),
               F32(F32(F32(y - glowy) / glowr) * F32(F32(y - glowy) / glowr)), NULL) AS dy2
    FROM rc, fin_lay
  ),
  -- the glow is an ellipse 1.6x wider than tall: ((x - gx)/r*1.6)^2
  colc AS MATERIALIZED (
    SELECT n AS x,
           iif(n >= max(bx0, 0) AND n < min(bx1, w),
               F32(F32(F32(F32(n - glowx) / glowr) * F32(1.6)) * F32(F32(F32(n - glowx) / glowr) * F32(1.6))), NULL) AS dx2,
           F32(1 - F32(abs(n - w * 0.5) / F32(w * F32(0.52)))) AS fade, floory
    FROM fin_lay, nums WHERE n < w
  ),
  glow AS MATERIALIZED (SELECT x, dx2, floory, iif(fade > 0, F32(F32(fade * fade) * F32(0.9)), NULL) AS fl FROM colc),
  over AS MATERIALIZED (SELECT id, max(layer), hex FROM (
    SELECT layer, id, hex FROM fin_text_px
    UNION ALL
    -- the subtitle's rules, either side
    SELECT 3, ly * w + n, 'A05090FF' FROM (
      SELECT suby + 7 * subs / 2 AS ly, subx, (length(sub) * 6 - 1) * subs AS subw, w, h FROM fin_lay) r, nums
    WHERE ly BETWEEN 0 AND h - 1 AND n BETWEEN 0 AND w - 1
      AND (n BETWEEN subx - subw / 3 - 14 AND subx - 14 - 1 OR n BETWEEN subx + subw + 14 AND subx + subw + 14 + subw / 3 - 1)
  ) GROUP BY id)
  SELECT y * w + x, rowc.r, rowc.g, rowc.b, dx2, iif(dy2 < 1, dy2, NULL),
         iif(y = floory, F32(210 * fl), NULL), iif(y = floory, F32(110 * fl), NULL), iif(y = floory, F32(230 * fl), NULL),
         over.hex
  FROM size, rowc CROSS JOIN glow LEFT JOIN over ON over.id = y * w + x;

-- 260 background stars from fmath.Rng(0xF1A1E): x, y, brightness
DROP TABLE IF EXISTS fin_star;
CREATE TABLE fin_star (i INTEGER PRIMARY KEY, id INTEGER, b REAL);
INSERT INTO fin_star
  WITH RECURSIVE g(k, x) AS (
    SELECT 0, 989726                                      -- 0xF1A1E
    UNION ALL
    SELECT k + 1, (SELECT (b | ((b << 5) & 4294967295)) - (b & ((b << 5) & 4294967295))
                   FROM (SELECT (a | (a >> 17)) - (a & (a >> 17)) AS b
                   FROM (SELECT (g.x | ((g.x << 13) & 4294967295)) - (g.x & ((g.x << 13) & 4294967295)) AS a
                         LIMIT -1) LIMIT -1))
    FROM g WHERE k < 780
  ),
  f AS MATERIALIZED (SELECT k, (x >> 8) / 16777216.0 AS f FROM g WHERE k > 0),
  s AS (
    SELECT n AS i, CAST(F32(fx.f * w) AS INTEGER) AS sx, CAST(F32(fy.f * h) AS INTEGER) AS sy,
           F32(F32(0.15) + F32(fb.f * F32(0.85))) AS b, w, h
    FROM size, nums JOIN f fx ON fx.k = 3 * n + 1 JOIN f fy ON fy.k = 3 * n + 2 JOIN f fb ON fb.k = 3 * n + 3
    WHERE n < 260
  )
  SELECT i, iif(sx >= 0 AND sx < w AND sy >= 0 AND sy < h, sy * w + sx, NULL), b FROM s;

DROP TABLE IF EXISTS fin_t;
CREATE TABLE fin_t (pulse REAL);
DROP TABLE IF EXISTS fin_add;
CREATE TABLE fin_add (id INTEGER PRIMARY KEY, r INTEGER, g INTEGER, b INTEGER);
DROP TABLE IF EXISTS fin_logo;
CREATE TABLE fin_logo (id INTEGER PRIMARY KEY, hex TEXT);
DROP TABLE IF EXISTS fin_refl;
CREATE TABLE fin_refl (id INTEGER PRIMARY KEY, r INTEGER, g INTEGER, b INTEGER);

-- @run frame
-- the pool of light pulses: 0.88 + 0.12*float32(sin(t*2.2))
DELETE FROM fin_t;
INSERT INTO fin_t SELECT F32(F32(0.88) + F32(F32(0.12) * F32(sin(:n / 60.0 * 2.2))));

-- the stars twinkle: intensity uint8(70*b*tw), added as colour*intensity/255
DELETE FROM fin_add;
INSERT INTO fin_add
  WITH s AS (
    SELECT id, CAST(F32(F32(70 * b) * F32(F32(0.55) + F32(F32(0.45) * F32(sin(:n / 60.0 * 1.7 + i * 0.7))))) AS INTEGER) AS v
    FROM fin_star WHERE id IS NOT NULL
  )
  SELECT id, sum(106 * v / 255), sum(48 * v / 255), sum(64 * v / 255) FROM s GROUP BY id;

-- @excerpt FINALE
-- The wordmark: three letters that bounce off the floor line,
-- dy = int((sin(t*2.4 + i*0.75) - 1) * scale/6). Its outline (four 1-pixel
-- shifts, dark), then the chrome gradient over it, every fourth row darker.
DELETE FROM fin_logo;
INSERT INTO fin_logo
  WITH
  letter AS MATERIALIZED (
    SELECT k.n AS k, substr(lang, k.n + 1, 1) AS ch, logox + k.n * 6 * scale AS x, logoy, scale, w, h,
           CAST((sin(:n / 60.0 * 2.4 + k.n * 0.75) - 1) * scale / 6 AS INTEGER) AS dy
    FROM fin_lay, nums k WHERE k.n < length(lang)
  ),
  dots AS MATERIALIZED (
    SELECT letter.*, f.row, f.col FROM letter JOIN font f ON f.ch = letter.ch
  ),
  outline AS (
    SELECT 1 AS layer, (logoy + dots.dy + o.oy + row * scale + sy.n) * w + x + o.ox + col * scale + sx.n AS id,
           '180A20FF' AS hex
    FROM dots
    CROSS JOIN (SELECT -1 AS ox, 0 AS oy UNION ALL SELECT 1, 0 UNION ALL SELECT 0, -1 UNION ALL SELECT 0, 1) o
    JOIN nums sy ON sy.n < scale JOIN nums sx ON sx.n < scale
    WHERE x + o.ox + col * scale + sx.n BETWEEN 0 AND w - 1
      AND logoy + dots.dy + o.oy + row * scale + sy.n BETWEEN 0 AND h - 1
  ),
  -- the gradient: cream to rose to violet down the glyph height
  grad0 AS (
    SELECT x + col * scale + sx.n AS xx, logoy + dy + row * scale + sy.n AS yy, logoy, scale, w
    FROM dots JOIN nums sy ON sy.n < scale JOIN nums sx ON sx.n < scale
    WHERE x + col * scale + sx.n BETWEEN 0 AND w - 1 AND logoy + dy + row * scale + sy.n BETWEEN 0 AND h - 1
  ),
  grad1 AS (SELECT *, max(0.0, min(1.0, F32(CAST(yy - logoy AS REAL) / (7 * scale)))) AS f FROM grad0),
  grad2 AS (
    SELECT xx, yy, w, f < 0.5 AS top, iif(f < 0.5, f * 2, (f - 0.5) * 2) AS u FROM grad1
  ),
  grad3 AS (
    SELECT xx, yy, w,
      CAST(iif(top, F32(232 + F32(23 * u)),  F32(255 + F32(-127 * u))) AS INTEGER) AS r,
      CAST(iif(top, F32(246 + F32(-90 * u)), F32(156 + F32(-124 * u))) AS INTEGER) AS g,
      CAST(iif(top, F32(255 + F32(-131 * u)), F32(124 + F32(-36 * u))) AS INTEGER) AS b
    FROM grad2
  ),
  grad AS (
    SELECT 2 AS layer, yy * w + xx AS id,
           iif(yy & 3 = 0, printf('%02X%02X%02XFF', r * 3 / 4, g * 3 / 4, b * 3 / 4), printf('%02X%02X%02XFF', r, g, b)) AS hex
    FROM grad3
  )
  SELECT id, hex FROM (SELECT id, max(layer), hex FROM (SELECT * FROM outline UNION ALL SELECT * FROM grad) GROUP BY id);

-- The reflection, under the letters' light: mirrored about the floor line,
-- fading over reflH rows (a = (1-d)^2, intensity 125*a), its colour from
-- cream to violet, added to what is there.
DELETE FROM fin_refl;
INSERT INTO fin_refl
  WITH
  letter AS MATERIALIZED (
    SELECT substr(lang, k.n + 1, 1) AS ch, logox + k.n * 6 * scale AS x, floory, reflh, scale, w, h,
           CAST((sin(:n / 60.0 * 2.4 + k.n * 0.75) - 1) * scale / 6 AS INTEGER) AS dy
    FROM fin_lay, nums k WHERE k.n < length(lang)
  ),
  px AS (
    SELECT x + f.col * scale + sx.n AS xx, floory + (6 - f.row) * scale - dy + sy.n AS yy, floory, reflh, w
    FROM letter JOIN font f ON f.ch = letter.ch JOIN nums sy ON sy.n < scale JOIN nums sx ON sx.n < scale
    WHERE x + f.col * scale + sx.n BETWEEN 0 AND w - 1 AND floory + (6 - f.row) * scale - dy + sy.n BETWEEN 0 AND h - 1
  ),
  d AS (SELECT xx, yy, w, F32(CAST(yy - floory AS REAL) / reflh) AS d FROM px),
  a AS (SELECT xx, yy, w, d, F32(F32(1 - d) * F32(1 - d)) AS a FROM d WHERE d <= 1),
  c AS (
    SELECT yy * w + xx AS id, CAST(F32(125 * a) AS INTEGER) AS v,
           CAST(F32(232 + F32(-104 * d)) AS INTEGER) AS r, CAST(F32(246 + F32(-214 * d)) AS INTEGER) AS g,
           CAST(F32(255 + F32(-167 * d)) AS INTEGER) AS b
    FROM a
  )
  SELECT id, r * v / 255, g * v / 255, b * v / 255 FROM c WHERE v > 0;
-- @end

-- Every pixel: background, + glow + stars (saturating), then the floor
-- line in float32, + the reflection, and the topmost text if any.
WITH
q1 AS (
  SELECT p.*, F32(dx2 + dy2) AS d2, pulse FROM fin_t CROSS JOIN fin_px p LIMIT -1
),
q2 AS (
  SELECT q1.*, iif(d2 < 1, F32(1 - d2), NULL) AS g1 FROM q1 LIMIT -1
),
q3 AS (
  SELECT q2.*, F32(g1 * F32(g1 * pulse)) AS gl FROM q2 LIMIT -1
),
q4 AS (
  SELECT q3.id, q3.hex, fr, fg, fb,
    min(255, q3.r + coalesce(CAST(F32(gl * 120) AS INTEGER), 0) + coalesce(a.r, 0)) AS r,
    min(255, q3.g + coalesce(CAST(F32(gl * 22) AS INTEGER), 0) + coalesce(a.g, 0)) AS g,
    min(255, q3.b + coalesce(CAST(F32(gl * 100) AS INTEGER), 0) + coalesce(a.b, 0)) AS b
  FROM q3 LEFT JOIN fin_add a ON a.id = q3.id LIMIT -1
),
q5 AS (
  SELECT id, hex,
    iif(fr IS NULL, r, CAST(min(255.0, F32(r + fr)) AS INTEGER)) AS r,
    iif(fr IS NULL, g, CAST(min(255.0, F32(g + fg)) AS INTEGER)) AS g,
    iif(fr IS NULL, b, CAST(min(255.0, F32(b + fb)) AS INTEGER)) AS b
  FROM q4 LIMIT -1
)
SELECT unhex(group_concat(coalesce(q5.hex, l.hex,
  printf('%02X%02X%02XFF', min(255, q5.r + coalesce(f.r, 0)), min(255, q5.g + coalesce(f.g, 0)),
         min(255, q5.b + coalesce(f.b, 0)))), ''))
FROM q5 LEFT JOIN fin_logo l ON l.id = q5.id LEFT JOIN fin_refl f ON f.id = q5.id;
